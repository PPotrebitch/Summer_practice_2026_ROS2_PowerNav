<?xml version='1.0'?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find power_nav_robot)/urdf/materials.xacro" />
    <xacro:include filename="$(find power_nav_robot)/urdf/robot_model.gazebo" />
    <xacro:include filename="$(find power_nav_robot)/urdf/wheel.xacro" />
    <xacro:include filename="$(find power_nav_robot)/urdf/inertial.xacro" />


    <!-- ================= БАЗА РОБОТА ================= -->
    <link name='base_footprint'/>
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name='base_link'>
        <visual name='base_visual'>
            <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.6 0.6 0.2"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.6 0.6 0.2"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="5.0" x="0.6" y="0.6" z="0.2">
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
        </xacro:inertial_box>
        
        <!-- Кастерное колесо (сфера) -->
        <visual name='caster_visual'>
            <origin xyz="-0.25 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="0.05" />
            </geometry>
            <material name="grey"/>
        </visual>
        <collision name='caster_collision'>
            <origin xyz="-0.25 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="0.05" />
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>0.0</mu>
                        <mu2>0.0</mu2>
                        <slip1>1.0</slip1>
                        <slip2>1.0</slip2>
                    </ode>
                </friction>
            </surface>
        </collision>
    </link>

    <!-- ================= КОЛЕСА ================= -->
    <xacro:wheel side="left" x="0.15" y="0.325" z="0.0"/>
    <xacro:wheel side="right" x="0.15" y="-0.325" z="0.0"/>

    <!-- ================= КАМЕРА ================= -->
    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.04 0.1 0.04"/></geometry>
            <material name="green"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.04 0.1 0.04"/></geometry>
        </collision>
        <xacro:inertial_box mass="0.1" x="0.04" y="0.1" z="0.04">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
    <joint name="camera_joint" type="fixed">
        <origin xyz="0.32 0 0.15" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>

    <!-- ОПТИЧЕСКИЙ ФРЕЙМ КАМЕРЫ (ОБЯЗАТЕЛЬНО для ROS 2 / OpenCV / AprilTag) -->
    <link name="camera_link_optical"/>
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <!-- Поворот: X вправо, Y вниз, Z вперед -->
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="camera_link">
        <material>Gazebo/Black</material>
        <sensor name="camera" type="camera">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <gz_frame_id>camera_link</gz_frame_id> 
            <camera>
                <camera_info_topic>camera/camera_info</camera_info_topic>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
            <topic>camera/image_raw</topic>
        </sensor>
    </gazebo>

    <!-- ================= ЛИДАР ================= -->
    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><cylinder radius="0.05" length="0.06"/></geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><cylinder radius="0.05" length="0.06"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.2" length="0.06" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <joint name="lidar_joint" type="fixed">
        <origin xyz="0.1 0 0.23" rpy="0 0 0"/>
        <child link="lidar_link"/>
        <parent link="base_link"/>
    </joint>

    <gazebo reference="lidar_link">
        <material>Gazebo/Red</material>
        <sensor name='gpu_lidar' type='gpu_lidar'>
          <pose>0 0 0 0 0 0</pose>
          <topic>scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id> 
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>${-pi}</min_angle>
                <max_angle>${pi}</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.08</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <visualize>true</visualize>
        </sensor>
    </gazebo>

</robot>